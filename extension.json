		"url": "https://ext.lceda.cn/item/chenlong11/power-net-highlighter"
	},
	"categories": "Schematic",
	"keywords": [
		"Power",
		"Net",
		"Highlight",
		"电源",
		"高亮"
	],
	"images": {
		"logo": "./images/logo.png"
	},
	"activationEvents": {},
	"entry": "./dist/index",
	"dependentExtensions": {},
	"headerMenus": {
